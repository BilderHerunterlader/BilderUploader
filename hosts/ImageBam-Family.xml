<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<hoster name="ImageBam-Family" version="0.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.w3schools.com hoster.xsd">
	<displayName>ImageBam (Family safe)</displayName>
	<displayIcon>imagebam.ico</displayIcon>
	<homePage>https://www.imagebam.com</homePage>

	<maxFileSize>10485760</maxFileSize>
	<fileNameFilter>(?i)\.(?:jpg|jpeg|png|gif)$</fileNameFilter>
	
	<maxConnections>6</maxConnections>
	
	<prepareUploadStep>
		<url>https://www.imagebam.com/</url>
		<regex>
			<pattern>&lt;meta name=&quot;csrf-token&quot; content=&quot;(.+?)&quot;</pattern>
			<replacementVariable variableName="CSRFToken" replacement="$1" />
		</regex>
	</prepareUploadStep>
	
	<prepareUploadStep>
		<url>https://www.imagebam.com/upload/session</url>
		<httpMethod>POST</httpMethod>
		<additionalField fieldName="thumbnail_size" fieldValue="2" />
		<additionalField fieldName="content_type" fieldValue="sfw" />
		<additionalField fieldName="comments_enabled" fieldValue="false" />
		<additionalHeader headerName="X-CSRF-TOKEN" headerValue="${CSRFToken}" />
		<regex>
			<pattern>&quot;data&quot;:&quot;(.+?)&quot;</pattern>
			<replacementVariable variableName="UploadData" replacement="$1" />
		</regex>
		<regex>
			<pattern>&quot;session&quot;:&quot;(.+?)&quot;</pattern>
			<replacementVariable variableName="UploadSessionID" replacement="$1" />
		</regex>
	</prepareUploadStep>
	
	<uploadStep>
		<url>https://www.imagebam.com/upload</url>
		<fieldName>files[0]</fieldName>
		<additionalField fieldName="data" fieldValue="${UploadData}" />
		<additionalField fieldName="_token" fieldValue="${CSRFToken}" />
		<failureRegex>
			<pattern>There was an error uploading the files</pattern>
		</failureRegex>
		<filenameRegex>
			<pattern>^(.{0,95}).*?(\.[^.]+)?$</pattern>
			<replacement>$1$2</replacement>
		</filenameRegex>
	</uploadStep>
	
	<prepareResultStep>
		<url>https://www.imagebam.com/upload/complete?session=${UploadSessionID}</url>
	</prepareResultStep>
	
	<uploadResultStep>
		<regex>
			<pattern>(?ism)(\[URL=[^\]]+\]\[IMG\][^\[]+\[/IMG\]\[/URL\])</pattern>
			<replacement>$1</replacement>
		</regex>
	</uploadResultStep>
</hoster>
